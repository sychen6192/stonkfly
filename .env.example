# Keep the key file outside git. ECDSA key, View + Trade, NO Transfer permission.
# Scope it to a dedicated portfolio funded with at most 100 quote-currency units.
COINBASE_KEY_FILE=coinbase-key.json
COINBASE_PORTFOLIO_ID=
# Live mode requires both this exact opt-in and the --live CLI flag.
STONKFLY_LIVE=I_ACCEPT_REAL_TRADES
# Optional location of verified MaleCNS files:
# STONKFLY_DATA=data

# Binance, in development: `run` still trades through Coinbase only.
# Spot Testnet keys (https://testnet.binance.vision) hold test funds only.
# Set the API key plus ONE signer: an Ed25519 key file (recommended) or an HMAC secret.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_PRIVATE_KEY_FILE=binance-testnet-ed25519.pem
# BINANCE_TESTNET_API_SECRET=
# Real exchange, checked read-only by `binance-check --live`.
# Enable Reading + Spot & Margin Trading only; NO withdrawals or transfers; restrict by IP.
# BINANCE_API_KEY=
# BINANCE_PRIVATE_KEY_FILE=binance-ed25519.pem
